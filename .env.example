PORT=3000
ADMIN_USER=admin
ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_UNICA
# Em produção configurar proxy HTTPS confiável e backup externo seguro.
TRUST_PROXY=0

# Deploy de testes: ao iniciar, o endpoint público de envio fica bloqueado por padrão.
STAGING=1
ENABLE_TEST_UPLOADS=0
# Configure um volume persistente montado neste diretório no provedor de hospedagem.
NAVEDOCS_PRIVATE_DIR=/data
